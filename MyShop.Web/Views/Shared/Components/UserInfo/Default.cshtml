@model MyShop.Entities.Models.ApplicationUser

@if (Model != null)
{
    <div class="d-flex flex-column align-items-center text-center">
        <img src="@(string.IsNullOrEmpty(Model.ProfileImage) ? "/img/user2-160x160.jpg" : Model.ProfileImage)" 
             alt="@Model.Name" 
             class="img-circle elevation-2 mb-2" 
             style="width: 60px; height: 60px; object-fit: cover; border-radius: 50%; border: 2px solid rgba(255,255,255,0.3);" />
        <span class="text-white font-weight-bold" style="font-size: 0.95rem; word-break: break-word; line-height: 1.3;">@Model.Name</span>
    </div>
}
else
{
    <div class="d-flex flex-column align-items-center text-center">
        <img src="/img/user2-160x160.jpg" 
             alt="Guest" 
             class="img-circle elevation-2 mb-2" 
             style="width: 60px; height: 60px; object-fit: cover; border-radius: 50%; border: 2px solid rgba(255,255,255,0.3);" />
        <span class="text-white-50" style="font-size: 0.9rem;">Welcome Guest</span>
    </div>
}