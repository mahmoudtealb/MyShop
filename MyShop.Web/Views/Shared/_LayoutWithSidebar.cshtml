@using Microsoft.AspNetCore.Http
@using MyShop.Utilities
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor httpContextAccessor

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MyShop</title>

    <!-- Fonts & Styles -->
    <link rel="stylesheet" href="https://fonts.googleapis.com/css?family=Source+Sans+Pro:300,400,400i,700&display=fallback">
    <link rel="stylesheet" href="/plugins/fontawesome-free/css/all.min.css">
    <link rel="stylesheet" href="/css/adminlte.min.css">
    <link rel="stylesheet" href="//cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/css/toastr.min.css" />
    <link rel="stylesheet" href="//cdn.datatables.net/2.2.2/css/dataTables.dataTables.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/MyShop.Web.styles.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="hold-transition sidebar-mini">
    <div class="wrapper">

        <!-- Navbar -->
        <nav class="main-header navbar navbar-expand navbar-white navbar-light">
            <ul class="navbar-nav">
                <li class="nav-item"><a class="nav-link" data-widget="pushmenu" href="#"><i class="fas fa-bars"></i></a></li>
                <li class="nav-item d-none d-sm-inline-block"><a href="/" class="nav-link">Home</a></li>
            </ul>
            <ul class="navbar-nav ms-auto d-flex align-items-center">
                <li class="nav-item position-relative">
                    @{
                        int? cartCount = null;
                        var cartCountStr = httpContextAccessor.HttpContext?.Session.GetString("ShoppingCartSession");
                        if (!string.IsNullOrEmpty(cartCountStr) && int.TryParse(cartCountStr, out var parsed))
                        {
                            cartCount = parsed;
                        }
                    }
                    <a class="nav-link position-relative d-flex align-items-center gap-1" href="/Customer/Cart/Index">
                        <i class="fas fa-shopping-cart fa-lg"></i> Cart
                        @if (cartCount.HasValue && cartCount.Value > 0)
                        {
                            <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger" style="font-size:0.8rem;">
                                @cartCount
                            </span>
                        }
                    </a>
                </li>
                @if (User.Identity.IsAuthenticated)
                {
                    <li class="nav-item">
                        <form id="logoutFormNavbar" asp-area="Identity" asp-page="/Account/Logout" method="post" class="d-inline m-0">
                            <button type="submit" class="nav-link btn btn-link p-2" style="color: inherit; text-decoration: none; border: none; background: none;">
                                <i class="fas fa-sign-out-alt"></i> Logout
                            </button>
                        </form>
                    </li>
                }
                else
                {
                    <li class="nav-item">
                        <a class="nav-link" href="/Identity/Account/Login">
                            <i class="fas fa-sign-in-alt"></i> Login
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/Identity/Account/Register">
                            <i class="fas fa-user-plus"></i> Register
                        </a>
                    </li>
                }
            </ul>
        </nav>

        <!-- Sidebar -->
        <aside class="main-sidebar sidebar-dark-primary elevation-4">
            <a href="/" class="brand-link">
                @* <img src="/img/AdminLTELogo.png" alt="Logo" class="brand-image img-circle elevation-3"> *@
                <span class="brand-text font-weight-light">MyShop</span>
            </a>

            <div class="sidebar">
                <div class="user-panel mt-3 pb-3 mb-3">
                    <div class="info">
                        @await Component.InvokeAsync("UserInfo")
                    </div>
                </div>

                <nav class="mt-2">
                    <ul class="nav nav-pills nav-sidebar flex-column">
                        <li class="nav-item">
                            <a href="/Customer/Home/Index" class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Home" ? "active" : "")">
                                <i class="nav-icon fas fa-home"></i>
                                <p>Home</p>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a href="/Customer/Cart/Index" class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Cart" ? "active" : "")">
                                <i class="nav-icon fas fa-shopping-cart"></i>
                                <p>Shopping Cart</p>
                            </a>
                        </li>

                        @if (User.Identity.IsAuthenticated)
                        {
                            <li class="nav-item">
                                <a href="/Customer/Home/CreateProduct" class="nav-link @(ViewContext.RouteData.Values["Action"]?.ToString() == "CreateProduct" ? "active" : "")">
                                    <i class="nav-icon fas fa-plus-circle"></i>
                                    <p>Add Product</p>
                                </a>
                            </li>
                        }

                        @if (User.Identity.IsAuthenticated)
                        {
                            if (User.IsInRole(SD.AdminRole))
                            {
                                <li class="nav-item">
                                    <a href="/Admin/Dashboard/Index" class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Dashboard" ? "active" : "")">
                                        <i class="nav-icon fas fa-tachometer-alt"></i>
                                        <p>Dashboard</p>
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a href="/Admin/Category/Index" class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Category" ? "active" : "")">
                                        <i class="nav-icon fas fa-list"></i>
                                        <p>Categories</p>
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a href="/Admin/Product/Index" class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Product" ? "active" : "")">
                                        <i class="nav-icon fas fa-box"></i>
                                        <p>Products</p>
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a href="/Admin/Users/Index" class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Users" ? "active" : "")">
                                        <i class="nav-icon fas fa-users"></i>
                                        <p>Users</p>
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a href="/Admin/Order/Index" class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Order" ? "active" : "")">
                                        <i class="nav-icon fas fa-shopping-bag"></i>
                                        <p>Orders</p>
                                    </a>
                                </li>
                            }
                            else
                            {
                                <li class="nav-item">
                                    <a href="/Identity/Account/Manage" class="nav-link @(ViewContext.RouteData.Values["Page"]?.ToString()?.Contains("Manage") == true ? "active" : "")">
                                        <i class="nav-icon fas fa-user-cog"></i>
                                        <p>My Profile</p>
                                    </a>
                                </li>
                            }
                        }
                    </ul>
                </nav>
                @* زر Logout في الـ Sidebar *@
                @if (User.Identity.IsAuthenticated)
                {
                    <form id="logoutFormSidebar" asp-area="Identity" asp-page="/Account/Logout" method="post" class="d-block mt-3 px-3">
                        <button type="submit" class="btn btn-danger w-100">
                            <i class="fas fa-sign-out-alt"></i> Logout
                        </button>
                    </form>
                }
            </div>
        </aside>

        <!-- Content -->
        <div class="content-wrapper">
            <section class="content-header">
                <div class="container-fluid">
                    <div class="row mb-2">
                       @*  <div class="col-sm-6">
                            <h1>@ViewData["Title"]</h1>
                        </div> *@
                    </div>
                </div>
            </section>

            <section class="content fade-in">
                @RenderBody()
            </section>
        </div>

    </div>

    <!-- Scripts -->
    <script src="/plugins/jquery/jquery.min.js"></script>
    <script src="/plugins/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="/js/adminlte.min.js"></script>

    <!-- SweetAlert2 -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <!-- Toastr -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/js/toastr.min.js"></script>
    <script>
        // Configure Toastr
        toastr.options = {
            "closeButton": true,
            "debug": false,
            "newestOnTop": true,
            "progressBar": true,
            "positionClass": "toast-top-right",
            "preventDuplicates": false,
            "onclick": null,
            "showDuration": "300",
            "hideDuration": "1000",
            "timeOut": "5000",
            "extendedTimeOut": "1000",
            "showEasing": "swing",
            "hideEasing": "linear",
            "showMethod": "fadeIn",
            "hideMethod": "fadeOut"
        };

        // Display TempData messages
        @if (TempData["success"] != null)
        {
            <text>
            toastr.success('@TempData["success"]', 'Success');
            </text>
        }

        @if (TempData["error"] != null)
        {
            <text>
            toastr.error('@TempData["error"]', 'Error');
            </text>
        }

        @if (TempData["info"] != null)
        {
            <text>
            toastr.info('@TempData["info"]', 'Info');
            </text>
        }

        @if (TempData["warning"] != null)
        {
            <text>
            toastr.warning('@TempData["warning"]', 'Warning');
            </text>
        }
    </script>

    <!-- DataTables -->
    <script src="https://cdn.datatables.net/2.2.2/js/dataTables.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html> 