@model MyShop.Entities.ViewModels.ProductVM

@{
    ViewBag.Title = "Edit Product";
    Layout = "_LayoutWithSidebar";
}

<div class="d-flex align-items-center gap-2 mb-4">
    <i class="fas fa-edit fa-2x text-primary"></i>
    <h2 class="mb-0 text-primary">Edit Product</h2>
</div>
<div class="d-flex justify-content-center align-items-start gap-4 flex-wrap">
    <!-- Form Container -->
    <div style="max-width: 400px; width: 100%;" class="p-4 shadow rounded-4 bg-white">
        <form asp-action="Edit" method="post" enctype="multipart/form-data" class="needs-validation" novalidate>
            <input type="hidden" asp-for="Product.Id" />
            <div class="mb-3">
                <label asp-for="Product.Name" class="form-label d-flex align-items-center gap-1"><i class="fas fa-tag"></i> Product Name</label>
                <input asp-for="Product.Name" class="form-control form-control-sm" />
                <span asp-validation-for="Product.Name" class="text-danger small"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Product.Description" class="form-label d-flex align-items-center gap-1"><i class="fas fa-align-left"></i> Description</label>
                <textarea asp-for="Product.Description" class="form-control form-control-sm" rows="3"></textarea>
                <span asp-validation-for="Product.Description" class="text-danger small"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Product.Price" class="form-label d-flex align-items-center gap-1"><i class="fas fa-dollar-sign"></i> Price</label>
                <input asp-for="Product.Price" class="form-control form-control-sm" />
                <span asp-validation-for="Product.Price" class="text-danger small"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Product.CategoryId" class="form-label d-flex align-items-center gap-1"><i class="fas fa-list"></i> Category</label>
                <select asp-for="Product.CategoryId" class="form-select form-select-sm" asp-items="Model.CategoryList">
                    <option value="">-- Select Category --</option>
                </select>
                <span asp-validation-for="Product.CategoryId" class="text-danger small"></span>
            </div>
            <div class="mb-4">
                <label for="file" class="form-label d-flex align-items-center gap-1"><i class="fas fa-image"></i> Upload New Image</label>
                <input type="file" name="file" class="form-control form-control-sm" id="imageUpload" />
            </div>
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-success btn-sm d-flex align-items-center gap-1"><i class="fas fa-save"></i> Save</button>
                <a asp-action="Index" class="btn btn-outline-secondary btn-sm d-flex align-items-center gap-1"><i class="fas fa-arrow-left"></i> Back</a>
            </div>
        </form>
    </div>
    <!-- Image Preview -->
    <div class="text-center" style="flex: 1;">
        <img id="previewImage"
             src="@Url.Content(string.IsNullOrEmpty(Model.Product.Img) ? "~/images/no-image.png" : "~/" + Model.Product.Img)"
             alt="Product Image"
             width="300"
             class="img-thumbnail d-block mx-auto mt-2 border border-primary-subtle shadow-sm rounded-4" />
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        document.getElementById("imageUpload").addEventListener("change", function (event) {
            const file = event.target.files[0];
            if (file) {
                const reader = new FileReader();
                reader.onload = function (e) {
                    document.getElementById("previewImage").src = e.target.result;
                };
                reader.readAsDataURL(file);
            }
        });
    </script>
}
