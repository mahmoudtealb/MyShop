@model MyShop.Entities.Models.Category

@{
    ViewBag.PageTitle = "Category Management";
    ViewBag.CardTitle = "Edit Category";
    Layout = "_LayoutWithSidebar";
}

<div class="d-flex align-items-center gap-2 mb-4 justify-content-center">
    <i class="fas fa-edit fa-2x text-primary"></i>
    <h2 class="mb-0 text-primary">@ViewBag.CardTitle</h2>
</div>
<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card shadow-sm rounded-4 p-4">
            <form asp-area="Admin" asp-action="Edit" method="post">
                <input type="hidden" asp-for="Id" />
                <div class="mb-3">
                    <label asp-for="Name" class="form-label d-flex align-items-center gap-1"><i class="fas fa-tag"></i> اسم التصنيف</label>
                    <input asp-for="Name" class="form-control" />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Discription" class="form-label d-flex align-items-center gap-1"><i class="fas fa-align-left"></i> الوصف</label>
                    <textarea asp-for="Discription" class="form-control"></textarea>
                    <span asp-validation-for="Discription" class="text-danger"></span>
                </div>
                <div class="mb-3 d-flex gap-2 justify-content-end">
                    <button type="submit" class="btn btn-success d-flex align-items-center gap-1"><i class="fas fa-save"></i> Update</button>
                    <a asp-area="Admin" asp-action="Index" class="btn btn-secondary d-flex align-items-center gap-1"><i class="fas fa-arrow-left"></i> Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        tinymce.init({
            selector: 'textarea[name="Discription"]',
            plugins: 'lists link image preview',
            toolbar: 'undo redo | bold italic underline | bullist numlist | link image | preview',
            height: 300,
            setup: function (editor) {
                editor.on('keyup', function (e) {
                    var content = editor.getContent({ format: 'text' });
                    var isRTL = /^[\u0600-\u06FF]/.test(content.trim());
                    editor.getBody().dir = isRTL ? 'rtl' : 'ltr';
                });
            }
        });
    </script>
}
