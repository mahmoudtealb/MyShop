@model IEnumerable<ApplicationUser>

@{
    ViewBag.PageTitle = "Users Management";
    ViewBag.CardTitle = "View Users";
    Layout = "_LayoutWithSidebar";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0 text-primary d-flex align-items-center gap-2">
        <i class="fas fa-users"></i> @ViewBag.CardTitle
    </h2>
    <a class="btn btn-success d-flex align-items-center gap-1" asp-area="Admin" asp-controller="Users" asp-action="Create">
        <i class="fas fa-user-plus"></i> Create New User
    </a>
</div>

<div class="card shadow-sm rounded-4 p-3">
    <table class="table table-hover align-middle text-center" width="100%">
        <thead class="table-light">
            <tr>
                <th><i class="fas fa-user"></i> Name</th>
                <th><i class="fas fa-envelope"></i> Email</th>
                <th><i class="fas fa-phone"></i> Phone Number</th>
                <th><i class="fas fa-cogs"></i> Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Name</td>
                    <td>@item.Email</td>
                    <td>@item.PhoneNumber</td>
                    <td>
                        <a class="btn btn-danger btn-sm d-inline-flex align-items-center gap-1"
                           asp-area="Admin"
                           asp-controller="UserManagement"
                           asp-action="Delete"
                           asp-route-id="@item.Id">
                            <i class="fas fa-trash-alt"></i> Delete
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
