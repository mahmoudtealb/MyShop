@page
@model EmailModel
@{
    ViewData["Title"] = "Manage Email";
    ViewData["ActivePage"] = ManageNavPages.Email;
}

<div class="d-flex align-items-center gap-2 mb-4">
    <i class="fas fa-envelope fa-2x text-primary"></i>
    <h3 class="mb-0">@ViewData["Title"]</h3>
</div>
<partial name="_StatusMessage" for="StatusMessage" />
<div class="row">
    <div class="col-md-6">
        <form id="email-form" method="post">
            <div asp-validation-summary="All" class="text-danger" role="alert"></div>
            @if (Model.IsEmailConfirmed)
            {
                <div class="mb-3">
                    <label asp-for="Email" class="form-label d-flex align-items-center gap-1 mb-2">
                        <i class="fas fa-envelope text-primary"></i> Email
                    </label>
                    <div class="input-group">
                        <input asp-for="Email" class="form-control" placeholder="Please enter your email." disabled />
                        <div class="input-group-append">
                            <span class="input-group-text text-success font-weight-bold"><i class="fas fa-check"></i></span>
                        </div>
                    </div>
                </div>
            }
            else
            {
                <div class="mb-3">
                    <label asp-for="Email" class="form-label d-flex align-items-center gap-1 mb-2">
                        <i class="fas fa-envelope text-primary"></i> Email
                    </label>
                    <input asp-for="Email" class="form-control" placeholder="Please enter your email." disabled />
                    <button id="email-verification" type="submit" asp-page-handler="SendVerificationEmail" class="btn btn-link d-flex align-items-center gap-1 mt-2 p-0"><i class="fas fa-paper-plane"></i> Send verification email</button>
                </div>
            }
            <div class="mb-3">
                <label asp-for="Input.NewEmail" class="form-label d-flex align-items-center gap-1 mb-2">
                    <i class="fas fa-envelope-open text-primary"></i> New Email
                </label>
                <input asp-for="Input.NewEmail" class="form-control" autocomplete="email" aria-required="true" placeholder="Please enter new email." />
                <span asp-validation-for="Input.NewEmail" class="text-danger"></span>
            </div>
            <button id="change-email-button" type="submit" asp-page-handler="ChangeEmail" class="w-100 btn btn-success btn-lg d-flex align-items-center justify-content-center gap-2">
                <i class="fas fa-save"></i> Change email
            </button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
