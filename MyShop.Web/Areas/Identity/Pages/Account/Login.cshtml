@page
@model LoginModel

@{
    ViewData["Title"] = "Log in";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-lg rounded-4">
                <div class="card-body p-5">
                    <div class="d-flex justify-content-center align-items-center gap-2 mb-4">
                        <i class="fas fa-sign-in-alt fa-2x text-primary"></i>
                        <h2 class="mb-0">@ViewData["Title"]</h2>
                    </div>
                    <form id="account" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>
                        <div class="mb-3">
                            <label asp-for="Input.Email" class="form-label"><i class="fas fa-envelope me-2 text-secondary"></i> Email</label>
                            <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="name@example.com" />
                            <span asp-validation-for="Input.Email" class="text-danger"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="Input.Password" class="form-label"><i class="fas fa-lock me-2 text-secondary"></i> Password</label>
                            <input asp-for="Input.Password" class="form-control" autocomplete="current-password" aria-required="true" placeholder="password" />
                            <span asp-validation-for="Input.Password" class="text-danger"></span>
                        </div>
                        <div class="form-check mb-3">
                            <input class="form-check-input" asp-for="Input.RememberMe" />
                            <label class="form-check-label" asp-for="Input.RememberMe">
                                <i class="fas fa-check-square me-1 text-success"></i> @Html.DisplayNameFor(m => m.Input.RememberMe)
                            </label>
                        </div>
                        <div class="d-grid mb-3">
                            <button id="login-submit" type="submit" class="btn btn-success btn-lg d-flex align-items-center justify-content-center gap-2">
                                <i class="fas fa-sign-in-alt"></i> Log in
                            </button>
                        </div>
                        <div class="text-center">
                            <p class="mb-1">
                                <a id="forgot-password" asp-page="./ForgotPassword"><i class="fas fa-question-circle me-1"></i> Forgot your password?</a>
                            </p>
                            <p class="mb-1">
                                <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl"><i class="fas fa-user-plus me-1"></i> Register as a new user</a>
                            </p>
                            <p>
                                <a id="resend-confirmation" asp-page="./ResendEmailConfirmation"><i class="fas fa-envelope-open-text me-1"></i> Resend email confirmation</a>
                            </p>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        @* <div class="col-md-6 mt-4 mt-md-0">
            <div class="card shadow-lg rounded-4">
                <div class="card-body p-5">
                    <h3 class="text-center mb-4">Use another service to log in</h3>

