@model int

@{
    Layout = "_LayoutWithSidebar";
}

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="p-5 bg-white rounded-4 shadow-sm text-center border">
                <div class="mb-4">
                    <i class="fas fa-check-circle fa-3x text-success"></i>
                </div>
                <h2 class="text-success fw-bold d-flex align-items-center justify-content-center gap-2 mb-3">
                    <i class="fas fa-smile-beam"></i> Thank You for Your Purchase!
                </h2>
                <p class="lead mt-3">Your order has been placed successfully.</p>
                <h4 class="my-4 d-flex align-items-center justify-content-center gap-2">
                    <i class="fas fa-receipt text-primary"></i> Order Number: <span class="text-primary fw-bold">#@Model</span>
                </h4>
                <p class="text-muted">A confirmation email has been sent with your order details.</p>
                <div class="mt-4 d-flex flex-wrap justify-content-center gap-2">
                    <a href="/Customer/Order/Invoice/@Model" class="btn btn-outline-secondary d-flex align-items-center gap-1" target="_blank">
                        <i class="fas fa-file-invoice"></i> View Invoice
                    </a>
                    <a href="/Customer/Order/DownloadInvoice/@Model" class="btn btn-outline-success d-flex align-items-center gap-1">
                        <i class="fas fa-download"></i> Download PDF
                    </a>
                    <a href="/Customer/Home/Index" class="btn btn-outline-primary d-flex align-items-center gap-1">
                        <i class="fas fa-arrow-left"></i> Continue Shopping
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
